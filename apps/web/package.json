{
  "name": "@voxi/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build -c vite.embed.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --port 8080",
    "test": "vitest run --passWithNoTests",
    "build:embed": "vite build -c vite.embed.config.ts"
  },
  "dependencies": {
    "@elevenlabs/react": "0.9.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "5.4.11"
  }
}
