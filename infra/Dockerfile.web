# Widget + dashboard (static SPA) behind nginx, proxying /api to the concierge API.
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /app
COPY apps/web/package.json ./
RUN pnpm install
COPY apps/web .
RUN pnpm build

FROM nginx:1.27-alpine
ENV PORT=80 API_UPSTREAM=http://concierge-api:4020 NGINX_ENVSUBST_FILTER="^(PORT|API_UPSTREAM)$"
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/nginx.conf.template /etc/nginx/templates/default.conf.template
RUN rm -f /etc/nginx/conf.d/default.conf
