# Rendered by the nginx image's envsubst at start.
# Vars: PORT (default 80), API_UPSTREAM (concierge-api base URL), NGINX_LOCAL_RESOLVERS (set by the image from resolv.conf).
server {
  listen ${PORT};
  listen [::]:${PORT};
  root /usr/share/nginx/html;
  charset utf-8;
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=on;
  location / { try_files $uri /index.html; }
  # Embeddable widget: cacheable but revalidated, so host pages pick up new builds quickly.
  location /embed/ { add_header Cache-Control "public, max-age=300"; try_files $uri =404; }
  location /api/ {
    set $api_upstream "${API_UPSTREAM}";
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
  }
}
